source "https://rubygems.org"

# 로컬 미리보기용 설정입니다. (GitHub Pages 배포는 이 파일을 쓰지 않아요)
# GitHub Pages와 같은 Jekyll 3.10 + 같은 플러그인을 사용합니다.
gem "jekyll", "~> 3.10"
gem "kramdown-parser-gfm"
gem "webrick"

group :jekyll_plugins do
  gem "jekyll-paginate"
  gem "jekyll-feed"
  gem "jekyll-seo-tag"
  gem "jekyll-sitemap"
end

# Ruby 3.4+ 에서 기본 포함이 빠진 라이브러리
gem "csv"
gem "base64"
gem "bigdecimal"
gem "logger"
gem "ostruct"
